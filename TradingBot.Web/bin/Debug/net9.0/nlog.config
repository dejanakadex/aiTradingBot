<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <targets>
    <target xsi:type="File" name="allfile" fileName="${environment:variable=TRADINGBOT_LOG_DIR}/trading-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=ToString}}"
            keepFileOpen="false" encoding="utf-8" />

    <target xsi:type="File" name="errorfile" fileName="${environment:variable=TRADINGBOT_LOG_DIR}/error-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=ToString}}"
            keepFileOpen="false" encoding="utf-8" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="allfile" />
    <logger name="*" minlevel="Error" writeTo="errorfile" />
  </rules>
</nlog>
